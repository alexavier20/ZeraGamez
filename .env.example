# Variáveis com o prefixo VITE_ são incluídas no código enviado ao navegador.
# Nunca armazene segredos, tokens ou senhas em variáveis VITE_.

# Credenciais server-side da aplicação registrada na Twitch para acesso à IGDB.
# Nunca use o prefixo VITE_ nestas variáveis.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
